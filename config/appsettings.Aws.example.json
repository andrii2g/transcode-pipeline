{
  "MediaPipeline": {
    "UploadProvider": "S3PresignedPost",
    "TranscodeProvider": "MediaConvert",
    "DefaultProfile": "web-standard-v1",
    "EnableManualTranscodeEndpoint": false
  },
  "UploadPolicy": {
    "DefaultMaxSizeBytes": 20971520,
    "AbsoluteMaxSizeBytes": 209715200,
    "SessionExpirationMinutes": 15,
    "Profiles": [
      "web-standard-v1"
    ],
    "NamedLimits": {
      "default": 20971520,
      "extended": 52428800,
      "large": 209715200
    }
  },
  "S3Storage": {
    "Region": "eu-west-1",
    "InputBucket": "replace-video-input",
    "OutputBucket": "replace-video-output",
    "UploadPrefix": "uploads",
    "OutputPrefix": "outputs",
    "PresignedPostExpirationMinutes": 15,
    "RequireDeclaredSizeMatch": true,
    "DeleteRejectedObjects": false,
    "ServerSideEncryption": "AES256"
  },
  "AwsNotifications": {
    "Region": "eu-west-1",
    "UploadTopicArn": "fake-arn:aws:sns:eu-west-1:111122223333:demo-video-upload-completed-prod",
    "MediaConvertTopicArn": "fake-arn:aws:sns:eu-west-1:111122223333:demo-mediaconvert-job-state-prod",
    "CertificateCacheMinutes": 60,
    "MaximumMessageAgeMinutes": 15,
    "RequestBodyLimitBytes": 524288
  },
  "MediaConvert": {
    "Region": "eu-west-1",
    "RoleArn": "fake-arn:aws:iam::111122223333:role/DemoMediaConvertServiceRole",
    "QueueArn": "",
    "WorkflowName": "Demo.Video.Transcode",
    "JobTemplateName": "Demo-Web-Transcode-v1",
    "StatusUpdateIntervalSeconds": 10
  },
  "WorkflowStore": {
    "Provider": "Sqlite",
    "ConnectionString": "" //Data Source=/data/workflows.db
  },
  "TranscodeDispatcher": {
    "NotificationCapacity": 256,
    "ScanIntervalSeconds": 2,
    "ClaimTimeoutMinutes": 5,
    "MaximumConcurrentJobs": 4,
    "InstanceId": ""
  }
}
