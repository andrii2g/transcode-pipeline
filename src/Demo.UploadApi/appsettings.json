{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MediaPipeline": {
    "UploadProvider": "LocalHttp",
    "TranscodeProvider": "FFmpeg",
    "DefaultProfile": "web-standard-v1",
    "EnableManualTranscodeEndpoint": false
  },
  "UploadPolicy": {
    "DefaultMaxSizeBytes": 20971520,
    "AbsoluteMaxSizeBytes": 209715200,
    "SessionExpirationMinutes": 15,
    "Profiles": [ "web-standard-v1" ],
    "NamedLimits": {
      "default": 20971520,
      "extended": 52428800,
      "large": 209715200
    }
  },
  "LocalStorage": {
    "PublicBaseUrl": "http://localhost:5080",
    "TemporaryUploadDirectory": "data/temp/uploads",
    "SourceDirectory": "data/source",
    "TemporaryOutputDirectory": "data/temp/transcodes",
    "OutputDirectory": "data/output",
    "RequireDeclaredSizeMatch": true,
    "MinimumFreeSpaceBytes": 1073741824,
    "MaximumConcurrentUploads": 4
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "MaximumConcurrentProcesses": 2,
    "ProcessTimeoutMinutes": 120,
    "HlsSegmentSeconds": 6,
    "KeepFailedOutput": false,
    "MaximumCapturedErrorBytes": 65536
  },
  "WorkflowStore": {
    "Provider": "Sqlite",
    "ConnectionString": "" //Data Source=data/workflows.db
  },
  "TranscodeDispatcher": {
    "NotificationCapacity": 256,
    "ScanIntervalSeconds": 2,
    "ClaimTimeoutMinutes": 130,
    "MaximumConcurrentJobs": 2,
    "InstanceId": ""
  },
  "AllowedHosts": "*"
}
