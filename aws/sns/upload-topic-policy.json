{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3PublishFromExactBucket",
      "Effect": "Allow",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:eu-west-1:111122223333:demo-video-upload-completed-prod",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "111122223333"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:s3:::replace-video-input"
        }
      }
    }
  ]
}
