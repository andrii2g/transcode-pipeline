{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputVideo",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::replace-video-input/uploads/*"
    },
    {
      "Sid": "ReadInputBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::replace-video-input",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "uploads/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::replace-video-output/outputs/*"
    },
    {
      "Sid": "ReadOutputBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::replace-video-output"
    }
  ]
}
