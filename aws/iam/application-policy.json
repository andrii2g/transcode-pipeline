{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndInspectUploads",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging"
      ],
      "Resource": "arn:aws:s3:::replace-video-input/uploads/*"
    },
    {
      "Sid": "CreateMediaConvertJobs",
      "Effect": "Allow",
      "Action": [
        "mediaconvert:CreateJob",
        "mediaconvert:GetJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassExactMediaConvertRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/DemoMediaConvertServiceRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "mediaconvert.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ConfirmExpectedSubscriptions",
      "Effect": "Allow",
      "Action": "sns:ConfirmSubscription",
      "Resource": [
        "arn:aws:sns:eu-west-1:111122223333:demo-video-upload-completed-prod",
        "arn:aws:sns:eu-west-1:111122223333:demo-mediaconvert-job-state-prod"
      ]
    }
  ]
}
